<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>카트 트랙 맞추기 - 결과</title>
    <meta name="description" content="카트라이더 트랙 맞추기 결과">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
</head>
<style>
    @font-face {
        font-family: nexon_bold;
        src: url("/font/nexon_bold.otf");
    }

    @font-face {
        font-family: nexon;
        src: url("/font/nexon.otf");
    }

    h1, h3 {
        margin-top: 20px;
        text-align: center;
        font-family: 'nexon_bold', sans-serif;
    }

    p {
        text-align: center;
        font-family: 'nexon', sans-serif;
    }

    body {
        text-align: center;
        background-color: #f8f9fa;
        font-family: 'nexon', sans-serif;
        padding-bottom: 50px;
    }

    .circle-progress-value {
        stroke-width: 6px;
        stroke: hsl(39, 100%, 50%);
    }

    .circle-progress-circle {
        stroke-width: 6px;
        stroke: hsl(39, 100%, 85%);
    }

    .circle-progress-text {
        fill: hsl(39, 100%, 50%);
    }

    .circle-progress {
        width: 260px;
        height: auto;
        margin: 0 auto;
    }

    .result-container {
        max-width: 760px;
        margin: 0 auto;
    }

    .card-detail {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 12px;
        padding: 12px 16px;
        text-align: left;
    }
</style>

<body>
    <h1>게임 결과</h1>
    <div class="progress my-4"></div>
    <% if (typeof totalCount !== 'undefined') { %>
        <p class="fs-4 mb-4">
            총 <strong><%= totalCount %></strong>문제 중 
            <strong class="text-primary"><%= correctCount %></strong>문제를 맞혔습니다!
            <span class="text-muted fs-6">(정답률: <%= result %>%)</span>
        </p>
    <% } %>
    <div class="mb-4">
        <a href="/" class="btn btn-primary btn-lg px-4">다시 도전하기</a>
    </div>

    <% if (typeof details !== 'undefined' && details && details.length > 0) { %>
        <div class="result-container px-3">
            <h3 class="mb-3">문항별 채점 결과</h3>
            <% details.forEach(function(item) { %>
                <div class="card card-detail border-<%= item.isCorrect ? 'success' : 'danger' %>">
                    <div class="d-flex align-items-center">
                        <img src="/track/<%= item.trackId %>.png" alt="트랙 이미지" width="100" class="rounded me-3 border">
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong>#<%= item.index %>번 문제</strong>
                                <span class="badge bg-<%= item.isCorrect ? 'success' : 'danger' %> fs-6">
                                    <%= item.isCorrect ? '정답' : '오답' %>
                                </span>
                            </div>
                            <div>내 답변: <strong><%= item.userAnswer || '(미입력)' %></strong></div>
                            <% if (!item.isCorrect) { %>
                                <div class="text-danger">정답: <strong><%= item.correctAnswer %></strong></div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>

    <script src="https://tigrr.github.io/circle-progress/js/circle-progress.js"></script>
    <script>
        new CircleProgress('.progress', {
            max: 100,
            value: <%= result %>,
            textFormat: 'percent',
        });
    </script>
</body>
</html>
