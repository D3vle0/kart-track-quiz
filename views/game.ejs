<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>카트 트랙 맞추기 - 문제 풀기</title>
    <meta name="description" content="카트라이더 트랙 맞추기 퀴즈 진행">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
</head>
<style>
    @font-face {
        font-family: nexon_bold;
        src: url("/font/nexon_bold.otf");
    }

    @font-face {
        font-family: nexon;
        src: url("/font/nexon.otf");
    }

    body {
        text-align: center;
        background-color: #f8f9fa;
        font-family: 'nexon', sans-serif;
        padding-bottom: 60px;
    }

    h1, h3 {
        margin-top: 20px;
        text-align: center;
        font-family: 'nexon_bold', sans-serif;
    }

    p {
        text-align: center;
        font-family: 'nexon', sans-serif;
        color: #6c757d;
    }

    .quiz-container {
        max-width: 640px;
        margin: 0 auto;
    }

    .progress-wrapper {
        background: #e9ecef;
        border-radius: 20px;
        height: 12px;
        overflow: hidden;
        margin: 16px 0 24px 0;
    }

    .progress-bar-custom {
        background: linear-gradient(90deg, #0d6efd, #0dcaf0);
        height: 100%;
        transition: width 0.3s ease;
    }

    .step-card {
        display: none;
        animation: fadeIn 0.25s ease-in-out;
    }

    .step-card.active {
        display: block;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .question-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
        padding: 28px;
        margin-bottom: 24px;
        border: 1px solid #e9ecef;
    }

    .track-image-container {
        min-height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .question-card img {
        max-width: 100%;
        width: 360px;
        height: auto;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .badge-number {
        font-size: 16px;
        padding: 8px 16px;
        border-radius: 20px;
    }

    .nav-buttons {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 20px;
    }
</style>

<body>
    <div class="quiz-container px-3">
        <h1>카트라이더 트랙 맞추기</h1>
        <p class="mb-2">제시된 이미지를 보고 트랙명을 입력하세요.<br><small>(Enter 키를 누르면 다음 문제로 자동 이동합니다)</small></p>

        <!-- 진행 상황 프로그레스 바 -->
        <div class="progress-wrapper">
            <div id="quizProgressBar" class="progress-bar-custom" style="width: 0%;"></div>
        </div>

        <form id="quizForm" action="/submit" method="post">
            <% for(var i = 0; i < res.length; i++){ %>
                <div class="step-card <%= i === 0 ? 'active' : '' %>" id="step-<%= i %>">
                    <div class="question-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-primary badge-number">문제 <%= i + 1 %> / <%= res.length %></span>
                            <span class="text-muted small">진행률: <span id="percent-<%= i %>"><%= Math.round(((i + 1) / res.length) * 100) %></span>%</span>
                        </div>

                        <div class="track-image-container">
                            <img src="/track/<%= res[i]['id'] %>.png" alt="트랙 이미지">
                        </div>

                        <input type="hidden" name="answer<%= i %>" value="<%= res[i]['id'] %>">
                        <div style="max-width: 400px; margin: 0 auto;">
                            <input type="text" 
                                   class="form-control form-control-lg text-center quiz-input" 
                                   placeholder="트랙 이름을 입력하세요" 
                                   autocomplete="off"
                                   name="input<%= i %>" 
                                   data-index="<%= i %>">
                        </div>

                        <!-- 이전 / 다음 / 제출 버튼 -->
                        <div class="nav-buttons">
                            <button type="button" 
                                    class="btn btn-outline-secondary btn-lg px-4" 
                                    onclick="navigateStep(<%= i - 1 %>)" 
                                    <%= i === 0 ? 'disabled style="visibility: hidden;"' : '' %>>
                                이전
                            </button>

                            <% if (i < res.length - 1) { %>
                                <button type="button" 
                                        class="btn btn-primary btn-lg px-4" 
                                        onclick="navigateStep(<%= i + 1 %>)">
                                    다음 문제
                                </button>
                            <% } else { %>
                                <button type="button" 
                                        class="btn btn-success btn-lg px-5 fw-bold" 
                                        onclick="submitQuiz()">
                                    정답 제출하기
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        </form>
    </div>

    <script>
        const totalSteps = <%= res.length %>;
        let currentStep = 0;
        let isNavigating = false; // 중복 건너뛰기 방지 플래그

        function updateProgress(step) {
            const percentage = Math.round(((step + 1) / totalSteps) * 100);
            const bar = document.getElementById('quizProgressBar');
            if (bar) {
                bar.style.width = percentage + '%';
            }
        }

        function navigateStep(targetStep) {
            if (isNavigating) return;
            if (targetStep < 0 || targetStep >= totalSteps) return;

            isNavigating = true;
            setTimeout(() => {
                isNavigating = false;
            }, 250);

            // 현재 스텝 숨기기
            const currentCard = document.getElementById('step-' + currentStep);
            if (currentCard) {
                currentCard.classList.remove('active');
            }

            // 대상 스텝 보이기
            currentStep = targetStep;
            const targetCard = document.getElementById('step-' + currentStep);
            if (targetCard) {
                targetCard.classList.add('active');
                // IME 입력 버퍼 정리 후 다음 인풋에 안전하게 포커스
                setTimeout(() => {
                    const input = targetCard.querySelector('.quiz-input');
                    if (input) {
                        input.focus();
                    }
                }, 40);
            }

            updateProgress(currentStep);
        }

        function submitQuiz() {
            if (isNavigating) return;
            isNavigating = true;
            document.getElementById('quizForm').submit();
        }

        // Enter 키 입력 처리 (한글 IME 조합 더블 엔터 및 다음 인풋 누수 방지)
        const inputs = document.querySelectorAll('.quiz-input');
        inputs.forEach((input, index) => {
            let isComposing = false;

            input.addEventListener('compositionstart', () => {
                isComposing = true;
            });

            input.addEventListener('compositionend', () => {
                isComposing = false;
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    // 한글 조합 중이면 다음 단계 이동을 막아 글자 누수 및 중복 실행 방지
                    if (e.isComposing || isComposing || e.keyCode === 229) {
                        return;
                    }

                    e.preventDefault();

                    // 현재 인풋을 blur 처리하여 IME 조합을 완전히 종료
                    input.blur();

                    setTimeout(() => {
                        if (index + 1 < totalSteps) {
                            navigateStep(index + 1);
                        } else {
                            submitQuiz();
                        }
                    }, 50);
                }
            });
        });

        // 초기 로드 시 1번 문제 프로그레스 바 설정 및 포커스
        updateProgress(0);
        if (inputs.length > 0) {
            inputs[0].focus();
        }
    </script>
</body>

</html>
